# ==============================================================================
# VARIABLES DE ENTORNO - OBSERVATORIO CIUDADANO SECOP II
# Copia este archivo como `.env` y completa tus credenciales reales.
# NUNCA subas el archivo `.env` al repositorio de Git.
# ==============================================================================

# 1. Google AI Studio (Gemini Embeddings 2 + LLM Orquestador)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-exp-03-07
GEMINI_LLM_MODEL=gemini-2.5-flash

# 2. Qdrant Cloud (Base Vectorial Serverless - Capa Gratuita)
QDRANT_URL=https://tu-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=tu_api_key_de_qdrant_aqui
QDRANT_COLLECTION_NAME=normativa_contratacion

# 3. Datos Abiertos Colombia - API Socrata (Opcional, amplía cuota de descarga)
SOCRATA_APP_TOKEN=
SOCRATA_DATASET_ID=jbjy-vk9h

# 4. Parámetros del Subconjunto de Datos (Reproducibilidad)
SECOP_DEPARTAMENTO=Valle del Cauca
SECOP_FECHA_INICIO=2024-01-01T00:00:00
SECOP_FECHA_FIN=2025-08-31T23:59:59

# 5. Límites de Seguridad para Demo Pública en Streamlit
MAX_QUERIES_PER_SESSION=15
SQL_MAX_ROWS_LIMIT=100

